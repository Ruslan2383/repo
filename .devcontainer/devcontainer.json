{
  "name": "Monorepo Dev",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "service": "api-node",
  "workspaceFolder": "/app",
  "postCreateCommand": "npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  },
  "remoteUser": "app"
}
